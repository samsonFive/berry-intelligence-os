{
  "benchmark_id": "atomic-ci-synthetic-v1",
  "version": 1,
  "description": "Company-neutral synthetic cases for structural and behavioral evaluation of atomic competitive-intelligence transcript extraction.",
  "cases": [
    {
      "id": "straight-factual-claim",
      "title": "Straight quantitative production claim",
      "segments": [
        {"text": "Our annual production increased from 120 tonnes to 150 tonnes.", "start_seconds": 0, "end_seconds": 6, "speaker_label": "Speaker"}
      ],
      "expectations": {
        "candidate_count": {"min": 1, "max": 1},
        "required_phrase_groups": [["120", "150", "tonnes"]],
        "required_segment_sets": [[0]],
        "expected_atomic_claims": 1,
        "max_link_count": 0,
        "category": "production volume",
        "notes": "Preserve both quantitative values."
      }
    },
    {
      "id": "qualified-forecast",
      "title": "Qualified production forecast",
      "segments": [
        {"text": "We think production could reach approximately 200 tonnes next season.", "start_seconds": 0, "end_seconds": 7, "speaker_label": "Executive"}
      ],
      "expectations": {
        "candidate_count": {"min": 1, "max": 1},
        "required_phrase_groups": [["200", "tonnes"]],
        "required_qualifiers": ["could", "approximately"],
        "prohibited_phrases": ["will reach"],
        "required_segment_sets": [[0]],
        "expected_atomic_claims": 1,
        "max_link_count": 0,
        "category": "forecast"
      }
    },
    {
      "id": "strategic-intent",
      "title": "Market-entry intent",
      "segments": [
        {"text": "We plan to enter the Pacific market next year, subject to regulatory approval.", "start_seconds": 0, "end_seconds": 8, "speaker_label": "Executive"}
      ],
      "expectations": {
        "candidate_count": {"min": 1, "max": 1},
        "required_phrase_groups": [["plan", "enter", "Pacific"], ["regulatory approval"]],
        "required_qualifiers": ["plan", "subject to"],
        "prohibited_phrases": ["entered the Pacific market", "is operating in the Pacific market"],
        "required_segment_sets": [[0]],
        "expected_atomic_claims": 1,
        "max_link_count": 0,
        "category": "strategic intent"
      }
    },
    {
      "id": "negative-expansion-statement",
      "title": "Explicit absence of expansion plans",
      "segments": [
        {"text": "We have no plans to expand the packing facility this year.", "start_seconds": 0, "end_seconds": 5, "speaker_label": "Manager"}
      ],
      "expectations": {
        "candidate_count": {"min": 0, "max": 1},
        "prohibited_phrases": ["will expand", "is expanding", "plans an expansion"],
        "max_link_count": 0,
        "category": "negative statement",
        "notes": "An accurate negative candidate is acceptable; a positive expansion claim is not."
      }
    },
    {
      "id": "attributed-hearsay",
      "title": "Grower-reported preference",
      "segments": [
        {"text": "Some growers have told us they may switch varieties if shelf life improves.", "start_seconds": 0, "end_seconds": 7, "speaker_label": "Interviewee"}
      ],
      "expectations": {
        "candidate_count": {"min": 1, "max": 1},
        "required_phrase_groups": [["growers", "told", "switch varieties"]],
        "required_qualifiers": ["some", "may", "if"],
        "prohibited_phrases": ["growers are switching varieties"],
        "required_segment_sets": [[0]],
        "expected_atomic_claims": 1,
        "max_link_count": 0,
        "category": "grower preference"
      }
    },
    {
      "id": "multiple-independent-claims",
      "title": "Two claims in one passage",
      "segments": [
        {"text": "We increased cold-storage capacity by 15 percent, and we plan to launch a new cultivar trial in June.", "start_seconds": 0, "end_seconds": 9, "speaker_label": "Executive"}
      ],
      "expectations": {
        "candidate_count": {"min": 2, "max": 2},
        "required_phrase_groups": [["capacity", "15 percent"], ["plan", "cultivar trial", "June"]],
        "required_qualifiers": ["plan"],
        "required_segment_sets": [[0]],
        "expected_atomic_claims": 2,
        "max_link_count": 0,
        "category": "atomic separation"
      }
    },
    {
      "id": "no-intelligence",
      "title": "Greeting and sponsorship only",
      "segments": [
        {"text": "Welcome back to the programme.", "start_seconds": 0, "end_seconds": 3, "speaker_label": "Host"},
        {"text": "This episode is sponsored by a fictional office-supply service.", "start_seconds": 3, "end_seconds": 8, "speaker_label": "Host"}
      ],
      "expectations": {
        "candidate_count": {"min": 0, "max": 0},
        "expected_atomic_claims": 0,
        "max_link_count": 0,
        "category": "no intelligence"
      }
    },
    {
      "id": "unsupported-inference-trap",
      "title": "Discussion without a decision",
      "segments": [
        {"text": "The board discussed several possible regions for future investment.", "start_seconds": 0, "end_seconds": 5, "speaker_label": "Director"},
        {"text": "No investment decision or preferred region has been selected.", "start_seconds": 5, "end_seconds": 9, "speaker_label": "Director"}
      ],
      "expectations": {
        "candidate_count": {"min": 0, "max": 1},
        "prohibited_phrases": ["will invest", "plans to invest in", "selected a region"],
        "max_link_count": 0,
        "category": "unsupported inference"
      }
    },
    {
      "id": "pronoun-context-dependency",
      "title": "Subject established in prior segment",
      "segments": [
        {"text": "Aster Growers operates the trial orchard.", "start_seconds": 0, "end_seconds": 4, "speaker_label": "Host"},
        {"text": "It expects the first commercial harvest could occur in 2028.", "start_seconds": 4, "end_seconds": 10, "speaker_label": "Host"}
      ],
      "expectations": {
        "candidate_count": {"min": 1, "max": 1},
        "required_phrase_groups": [["Aster Growers", "could", "2028"]],
        "required_qualifiers": ["expects", "could"],
        "prohibited_phrases": ["will harvest in 2028"],
        "required_segment_sets": [[0, 1]],
        "expected_atomic_claims": 1,
        "max_link_count": 0,
        "category": "context dependency"
      }
    },
    {
      "id": "numeric-transcript-ambiguity",
      "title": "Garbled machine-transcribed number",
      "segments": [
        {"text": "The machine line handled maybe fifteen or fifty crates, the audio is unclear.", "start_seconds": 0, "end_seconds": 6, "speaker_label": "Speaker"}
      ],
      "expectations": {
        "candidate_count": {"min": 0, "max": 0},
        "prohibited_phrases": ["handled 15 crates", "handled 50 crates"],
        "expected_atomic_claims": 0,
        "max_link_count": 0,
        "category": "transcript ambiguity"
      }
    },
    {
      "id": "repeated-nearby-claim",
      "title": "Nearby repetition",
      "segments": [
        {"text": "The trial may add ten hectares next season.", "start_seconds": 0, "end_seconds": 5, "speaker_label": "Speaker"},
        {"text": "As I said, the trial may add ten hectares next season.", "start_seconds": 5, "end_seconds": 10, "speaker_label": "Speaker"}
      ],
      "expectations": {
        "candidate_count": {"min": 1, "max": 1},
        "required_phrase_groups": [["may", "ten hectares", "next season"]],
        "required_qualifiers": ["may"],
        "expected_atomic_claims": 1,
        "max_link_count": 0,
        "category": "deduplication"
      }
    },
    {
      "id": "similar-distinct-claims",
      "title": "Similar wording with distinct meaning",
      "segments": [
        {"text": "Regional supply increased by 8 percent this quarter.", "start_seconds": 0, "end_seconds": 5, "speaker_label": "Analyst"},
        {"text": "Regional demand softened by 3 percent during the same quarter.", "start_seconds": 5, "end_seconds": 10, "speaker_label": "Analyst"}
      ],
      "expectations": {
        "candidate_count": {"min": 2, "max": 2},
        "required_phrase_groups": [["supply", "8 percent"], ["demand", "3 percent"]],
        "required_segment_sets": [[0], [1]],
        "expected_atomic_claims": 2,
        "max_link_count": 0,
        "category": "distinct claims"
      }
    }
  ]
}
