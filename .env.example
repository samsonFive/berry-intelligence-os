# Copy to .env in the repo root. scripts/run_local.sh and scripts/run_local.ps1
# source it if present.
# Never commit .env. Never paste real values into chat, PRs, or screenshots.

# --- Optional live Today lanes (canonical names only) ---
# PERPLEXITY_API_KEY=
# EXA_API_KEY=
# APITUBE_API_KEY=
# NEWSCATCHER_API_KEY=

# CatchAll is not request-time on Today. Leave unset unless you run background CatchAll.
# CATCHALL_API_KEY=

# Optional reader bake-off. Do not invent values.
# FIRECRAWL_API_KEY=
# JINA_API_KEY=

# --- Local bind ---
# BIOS_APP_BIND=127.0.0.1
# BIOS_APP_PORT=8000
# BIOS_MODE=authoring

# Optional bounded social pilot; leave unset until free access/billing is verified.
# Local app launchers load .env; standalone CLIs require inherited process env.
# Never paste values into chat, manifests, screenshots, or tracked files.
# BIOS_SOCIAL_YOUTUBE_KEY=
# SOCIAVAULT_API_KEY=
# APIFY_TOKEN=
