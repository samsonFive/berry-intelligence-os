{
  "kind": "berry-intelligence-os-patent-watchlist",
  "provider_preference": ["uspto_odp", "google_patents_json"],
  "publication_after": "2023-01-01",
  "max_candidates_per_run": 50,
  "queries": [
    {
      "id": "blueberry-plant-named",
      "q": "(\"blueberry plant named\")",
      "berry_hint": "berry-blueberry"
    },
    {
      "id": "strawberry-plant-named",
      "q": "(\"strawberry plant named\" OR \"strawberry plant variety named\")",
      "berry_hint": "berry-strawberry"
    },
    {
      "id": "raspberry-plant-named",
      "q": "(\"raspberry plant named\")",
      "berry_hint": "berry-raspberry"
    },
    {
      "id": "blackberry-plant-named",
      "q": "(\"blackberry plant named\")",
      "berry_hint": "berry-blackberry"
    }
  ],
  "exclude_terms": [
    "cranberry",
    "lingonberry",
    "huckleberry",
    "goji",
    "acai",
    "açaí",
    "elderberry",
    "mulberry",
    "serviceberry",
    "juniper berry"
  ],
  "use_entity_assignee_queries": false,
  "assignee_query_roles": [
    "breeder",
    "genetics_licensor",
    "patent_assignee",
    "nursery",
    "private_breeding_program",
    "public_breeding_program"
  ],
  "assignee_query_skip_roles": [
    "government_regulator"
  ]
}
