# Copy to deploy/.env and fill in. Never commit the filled file.
BIOS_REVIEW_USERNAME=replace-me
BIOS_REVIEW_PASSWORD=replace-me-with-a-long-random-value
# Signing secret for the application session cookie. Generate on the host:
#   openssl rand -hex 32
# Do not reuse BIOS_REVIEW_PASSWORD.
BIOS_SESSION_SECRET=replace-me-with-openssl-rand-hex-32
BIOS_DEMO_SITE=http://localhost
BIOS_DEMO_RUNTIME=../demo-runtime
# App is loopback-only. Public traffic must go through Caddy on 80/443.
BIOS_APP_BIND=127.0.0.1
BIOS_APP_PORT=8000
# Emergency browser prompt. Leave off so /login is the normal sign-in.
# BIOS_BASIC_AUTH=false
# Optional. Enables AI-Assisted Report Builder V1's scope interpretation
# and grounded section synthesis (app/services/ai_gateway/). Leave unset
# and the feature degrades gracefully to a deterministic fallback --
# nothing else in the app requires this key. Never commit a real value.
# PERPLEXITY_API_KEY=replace-me
