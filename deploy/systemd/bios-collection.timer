[Unit]
Description=Run Berry Intelligence OS recurring collection every 4 hours

[Timer]
# Every 4 hours, on the hour. A single oneshot service instance plus
# systemd's own "a new timer trigger while the unit is still active is
# coalesced, not run concurrently" behavior is the overlap guard -- no
# additional lock file is managed by this unit (CollectionRunner has its
# own, at inbox/operations/collection.lock, for the same reason).
OnCalendar=*-*-* 0/4:00:00
# Spread load if several units fire at the same instant; avoids every
# scheduled task on the box waking up on the exact same clock edge.
RandomizedDelaySec=300
# Catch up on a run missed while the VPS was down/rebooting, instead of
# silently waiting up to 4 hours for the next scheduled edge.
Persistent=true

[Install]
WantedBy=timers.target
