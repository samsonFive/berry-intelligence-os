[Unit]
Description=Berry Intelligence OS storage and inode monitor
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/berry-storage-controls/current/scripts/storage_monitor.py --config /etc/berry-storage-controls/policy.json --apply
TimeoutStartSec=45
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/berry-storage-controls /opt/berry-intelligence-os/demo-runtime/inbox/operations/storage
# Existing release locks are opened read/write solely for nonblocking flock.
ReadWritePaths=/run/lock/berry-review.lock /opt/berry-platform-releases/brand-media-release.lock /opt/berry-platform-releases/watchlist524-release.lock
MemoryMax=96M
CPUQuota=10%
TasksMax=16
StandardOutput=journal
StandardError=journal
SyslogIdentifier=berry-storage-monitor
