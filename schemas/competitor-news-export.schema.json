{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitor news export packet",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "generated_at",
    "scope",
    "capture",
    "records",
    "validation",
    "change_history"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object"
    },
    "capture": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "change_history": {
      "type": "array"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "external_record_id",
          "source_system",
          "record_status",
          "publish_to_landscape",
          "headline",
          "summary",
          "event_type",
          "event_date",
          "published_date",
          "accessed_date",
          "source_name",
          "source_url",
          "source_type",
          "competitor_id",
          "competitor_name",
          "related_entity_type",
          "related_entity_id",
          "related_entity_name",
          "berry",
          "region",
          "country",
          "topics",
          "verification_status",
          "confidence_level",
          "review_notes",
          "imported_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "external_record_id": {
            "type": "string",
            "minLength": 1
          },
          "source_system": {
            "type": "string",
            "minLength": 1
          },
          "record_status": {
            "enum": [
              "approved",
              "unreviewed"
            ]
          },
          "publish_to_landscape": {
            "const": false
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "event_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "published_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "accessed_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "source_name": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "source_type": {
            "type": "string"
          },
          "competitor_id": {
            "type": "string",
            "minLength": 1
          },
          "competitor_name": {
            "type": "string",
            "minLength": 1
          },
          "related_entity_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "related_entity_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "related_entity_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "berry": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "region": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "country": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_status": {
            "enum": [
              "source_reviewed",
              "unreviewed"
            ]
          },
          "confidence_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_notes": {
            "type": "string"
          },
          "imported_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  }
}
